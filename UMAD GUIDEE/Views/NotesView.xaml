<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UMAD_GUIDEE.Views.NotesView"
             xmlns:vm="clr-namespace:UMAD_GUIDEE.ViewModels"
             x:DataType="vm:NotesViewModel"
             xmlns:data="clr-namespace:ShareProject.Models.DTOs.OutputDTO;assembly=ShareProject"
             Title="NotesView"
             Shell.FlyoutBehavior="Flyout">
    <!--VerticalStackLayout-->
        <!-- Contenido principal -->
        <Grid RowDefinitions="Auto,*"
          ColumnDefinitions="*">
            <Button Grid.Row="0"
                Grid.Column="0"
                Text="Add New Part"
                Margin="20, 10, 20, 10"
                Command="{Binding AddNewNoteCommand}"
                    IsVisible="{Binding IsVisible}"/>

            <RefreshView Grid.Row="1"
                     Grid.Column="0"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadDataCommand}">
                <CollectionView ItemsSource="{Binding Notes}"
                            SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                            SelectionChangedCommand="{Binding NoteSelectedCommand}"
                            SelectionMode="Single"
                            Margin="30,20,30,30">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="20" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="data:NoteOutputDTO">
                            <VerticalStackLayout Padding="15,10"
                                             Margin="10,5,10,5">
                                <Label Text="{Binding Title, StringFormat='Note: {0}'}"
                                   TextColor="White" />
                                <Label Text="{Binding Description, StringFormat='Description: {0}'}" />
                                <Label Text="{Binding WorkerFullName, StringFormat='Worker: {0}'}" />
                                <Label Text="{Binding CategoryName, StringFormat='Category: {0}'}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>   
            </RefreshView>
        </Grid>

    <!--/VerticalStackLayout-->
</ContentPage>