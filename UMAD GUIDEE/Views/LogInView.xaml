<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:UMAD_GUIDEE"
             x:Class="UMAD_GUIDEE.Views.LogInView"
             xmlns:vm="clr-namespace:UMAD_GUIDEE.ViewModels"
             x:DataType="vm:LogInViewModel"
             Title="LogInView">
    <VerticalStackLayout>
        <Entry Placeholder="Email"
               Keyboard="Email"
               Text="{Binding Email}"/>

        <Entry Placeholder="Password"
               IsPassword="True"
               Text="{Binding Password}"/>
        <Button Command="{Binding LoginCommand}"
                Text="Login"
                x:Name="DetailButton"></Button>
        <ActivityIndicator IsRunning="{Binding IsRunning}"></ActivityIndicator>
    </VerticalStackLayout>
</ContentPage>