<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UMAD_GUIDEE.Views.NoteView"
             xmlns:vm="clr-namespace:UMAD_GUIDEE.ViewModels"
             x:DataType="vm:NoteViewModel"
             xmlns:data="clr-namespace:ShareProject.Models;assembly=ShareProject"
             Title=" "
             Shell.TitleColor="Black"
             Shell.ForegroundColor="Black"
             Background="White"
             Shell.BackgroundColor="White">
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            <!-- Header con título -->
            <Label Text="Nueva Nota" 
               FontSize="24"
               FontAttributes="Bold"
               TextColor="#333333"
               HorizontalOptions="Center"/>

            <!-- Tarjeta contenedora -->
            <Frame CornerRadius="12" 
               Padding="15"
               BackgroundColor="White"
               BorderColor="#e0e0e0"
               HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <!-- Campo Título -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Título" 
                           FontAttributes="Bold"
                           TextColor="#333333"/>
                        <Entry Text="{Binding Title}" 
                           Placeholder="Ingrese el título"
                           TextColor="#333333"
                           BackgroundColor="Transparent"
                           ClearButtonVisibility="WhileEditing"/>
                    </VerticalStackLayout>

                    <!-- Campo Descripción -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Descripción" 
                           FontAttributes="Bold"
                           TextColor="#333333"/>
                        <Editor Text="{Binding Description}" 
                            Placeholder="Ingrese la descripción"
                            TextColor="#333333"
                            BackgroundColor="Transparent"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="100"/>
                    </VerticalStackLayout>

                    <!-- Selector de Categoría -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Categoría" 
                           FontAttributes="Bold"
                           TextColor="#333333"/>
                        <Picker Title="Seleccione una categoría"
                            ItemsSource="{Binding Categories}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedCategory}"
                            TextColor="#333333"
                            BackgroundColor="Transparent">
                        </Picker>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Botones de acción -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <Button Text="Guardar"
                    Command="{Binding SaveDataCommand}"
                    BackgroundColor="#008dbf"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    FontAttributes="Bold"/>

                <Button Text="Cancelar"
                    Grid.Column="1"
                    Command="{Binding DoneEditingCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#008dbf"
                    BorderColor="#008dbf"
                    BorderWidth="1"
                    CornerRadius="8"
                    HeightRequest="50"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>