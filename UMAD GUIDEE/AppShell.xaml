<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="UMAD_GUIDEE.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UMAD_GUIDEE"
    xmlns:views="clr-namespace:UMAD_GUIDEE.Views"
    xmlns:pages="clr-namespace:UMAD_GUIDEE.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="App">


    <!--FlyoutItem
     Title="Home">

        <ShellContent
            Title="Home" 
             Route="HomePage"
             ContentTemplate="{DataTemplate pages:HomePage}"
        >

        </ShellContent>

    </FlyoutItem-->

    <FlyoutItem
         Title="Notes">
        
            <ShellContent
                Title="Notes" 
                 Route="NotesView"
                 ContentTemplate="{DataTemplate views:NotesView}"
                x:Name="NoteOption"
                IsVisible="True">

            </ShellContent>
        
    </FlyoutItem>

    <Shell.FlyoutFooter>
        <Button
        Text="Output"
        Clicked="LogOut"
        x:Name="OutputButton"></Button>
    </Shell.FlyoutFooter>
</Shell>
